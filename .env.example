# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys. Use the new keys, not the legacy anon/service_role JWTs.
# Publishable key (sb_publishable_...): safe in the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres connection string (Supabase → Connect → Session pooler). Used only by `npm run db:push`.
SUPABASE_DB_URL=
# Any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Public base URL, e.g. http://localhost:3000 locally or https://dues.vercel.app in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
